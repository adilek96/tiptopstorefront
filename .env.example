# Значения задаются в Coolify (Application -> Environment Variables).
# Все NEXT_PUBLIC_* должны быть помечены как Build Variable: Next.js
# подставляет их в бандл на этапе сборки, а не в рантайме.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.tiptop.169-58-147-171.sslip.io
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Идентификаторы из базы Medusa — печатает сид-скрипт бэкенда
NEXT_PUBLIC_MEDUSA_REGION_ID=
NEXT_PUBLIC_SHIPPING_OPTION_METRO_ID=
NEXT_PUBLIC_SHIPPING_OPTION_CITY_ID=
NEXT_PUBLIC_SHIPPING_OPTION_COUNTRY_ID=

# Тег товаров для блока «Топ 10». Создаётся вручную в админке;
# пока пусто — блок показывает последние товары.
NEXT_PUBLIC_MEDUSA_TOP_TAG_ID=

# Хосты, с которых next/image разрешено грузить картинки (через запятую)
NEXT_PUBLIC_IMAGE_HOSTS=s3.tiptop.169-58-147-171.sslip.io

# Поиск ходит в Medusa (/store/search), отдельных переменных не требует.
